# Arihant's Food Journal — environment variables
# Copy to .env.local and fill in. The app runs fully offline with NONE of these;
# they only enable optional Google sign-in + MongoDB cloud sync.

# --- Cloud sync (optional) ---------------------------------------------------
# MongoDB connection string. Stores each signed-in user's journal.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"

# Google OAuth 2.0 Web Client ID (from Google Cloud Console → Credentials).
# Same value in both vars: the public one renders the sign-in button,
# the server one verifies the ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"

# Secret used to sign long-lived session cookies (keeps users signed in for 30 days).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-hex-char-string"

# --- Metadata (optional) -----------------------------------------------------
# Canonical site URL for SEO (sitemap, robots, Open Graph). On Vercel this is
# auto-derived from VERCEL_URL if omitted.
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Note: AI provider API keys are NOT set here. Each user enters their own key
# in the in-app Settings page; it stays on their device.
